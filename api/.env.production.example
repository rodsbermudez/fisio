APP_NAME=Fisio
APP_ENV=production
APP_DEBUG=false
APP_URL=https://fisio.patropicomunica.com.br
APP_TIMEZONE=America/Sao_Paulo
# IMPORTANTE: execute "php artisan key:generate" para gerar uma chave única.
APP_KEY=

# Domínio do frontend (CORS / Sanctum)
FRONTEND_URLS=https://fisio.patropicomunica.com.br
SANCTUM_STATEFUL_DOMAINS=fisio.patropicomunica.com.br
SESSION_DOMAIN=fisio.patropicomunica.com.br

# Banco de dados de produção (crie no CloudPanel antes do deploy)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fisio_prod
DB_USERNAME=fisio_prod_user
DB_PASSWORD=

# Drivers
BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# E-mail: configure um serviço real (SMTP/Resend/Amazon SES) antes de liberar o sistema.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
